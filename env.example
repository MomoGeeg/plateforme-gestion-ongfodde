# Exemple de variables pour lancer le backend sans application-local.properties.
# Sous PowerShell (session courante) :
#   $env:SPRING_DATASOURCE_URL="jdbc:postgresql://..."
#   $env:SPRING_DATASOURCE_USERNAME="..."
#   $env:SPRING_DATASOURCE_PASSWORD="..."
#   $env:APP_JWT_SECRET="votre-secret-jwt-au-moins-32-caracteres"
#   .\mvnw.cmd spring-boot:run

SPRING_DATASOURCE_URL=jdbc:postgresql://HOTE:5432/postgres
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# Obligatoire sauf profil dev — minimum 32 octets UTF-8 (≈ 32 caractères ASCII)
# Exemple valide (à remplacer) :
# APP_JWT_SECRET=FoddeLocalDevSecret-ChangeMe-32charsMinimum!!123456789
APP_JWT_SECRET=

# Durée du token en millisecondes (défaut 86400000 = 24 h)
# APP_JWT_EXPIRATION=86400000

# false = POST /api/auth/init interdit (403). true uniquement pour bootstrap admin ponctuel.
APP_INIT_ENDPOINT_ENABLED=false

# Origines front autorisées, séparées par des virgules
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
